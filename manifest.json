{
  "manifest_version": 3,
  "name": "AI Hint",
  "version": "2.5.2",
  "description": "Get fast answers about selected text, summarize pages, and save a searchable local answer history.",
  "minimum_chrome_version": "138",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "commands",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*",
    "https://ai.api.cloud.yandex.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Hint",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "ask-hint": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "MacCtrl+Shift+Space"
      },
      "description": "Ask AI Hint about the selected text"
    },
    "style-study": { "suggested_key": { "default": "Ctrl+Shift+2", "mac": "MacCtrl+Shift+2" }, "description": "Switch AI Hint to Study style" },
    "style-code": { "suggested_key": { "default": "Ctrl+Shift+3", "mac": "MacCtrl+Shift+3" }, "description": "Switch AI Hint to Code style" },
    "style-translate": { "suggested_key": { "default": "Ctrl+Shift+4", "mac": "MacCtrl+Shift+4" }, "description": "Switch AI Hint to Translate style" }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
